{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "envMode": "loose",
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["$TURBO_DEFAULT$", "!openapi.yaml"],
      "outputs": ["openapi.yaml", "internal/handlers/docs/assets/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate", "^generate"],
      "env": ["VERSION", "APP_VERSION"],
      "outputs": ["bin/**", "build/**", ".svelte-kit/**"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["generate", "^generate"]
    },
    "lint": {
      "dependsOn": ["generate", "^generate"]
    },
    "test": {
      "dependsOn": ["generate", "^generate"]
    },
    "fmt": {
      "cache": false
    },
    "fmt:check": {}
  }
}
