# Copy to .env to override the development defaults. Vite loads it. Every
# variable is declared and validated in src/env.ts.

# Where server-side rendering reaches the API. The browser uses /api on the
# page's origin instead.
API_URL=http://localhost:3101

# Build version, read at build time only; the Dockerfile sets it from VERSION.
# /readyz answers 503 while the API reports a different version.
APP_VERSION=dev
