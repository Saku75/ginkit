# Copy to .env to override the development defaults. Air loads it on every
# restart; without it the API runs on 3101 under /api.

# development, staging, or release. Development runs Gin in debug mode.
MODE=development

# The web app's dev server proxies /api here.
PORT=3101

# URL prefix everything but the probes is mounted under. Leave empty when a
# proxy strips the prefix instead; it should send X-Forwarded-Prefix.
BASE_PATH=

# debug, info, warn, or error.
LOG_LEVEL=info

# text or json.
LOG_FORMAT=text

# Comma-separated IPs or CIDRs whose X-Forwarded-For header is trusted,
# e.g. 10.0.0.0/8,192.168.1.10. Empty trusts none.
TRUSTED_PROXIES=

# Header that always carries the real client IP, e.g. CF-Connecting-IP behind
# Cloudflare. Trusted from any peer, so only set it when every request comes
# through that platform. Empty uses X-Forwarded-For from TRUSTED_PROXIES.
CLIENT_IP_HEADER=

# Comma-separated origins allowed from browsers, e.g.
# https://app.example.com,http://localhost:5173. * allows all. Empty sends no
# CORS headers, which is fine while the web app proxies /api.
CORS_ALLOWED_ORIGINS=

# How long to keep serving after SIGTERM while /readyz fails, so load
# balancers stop routing here first. Defaults to 15s; 0s exits at once.
SHUTDOWN_DELAY=0s

# GitLab instance behind the /v1/projects routes, without /api/v4.
GITLAB_URL=https://gitlab.com

# Token with read_api for the projects to show. Empty sends no credentials,
# which reaches public projects only.
GITLAB_TOKEN=
