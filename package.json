{
  "name": "ginkit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "docker:build": "scripts/build-images.sh",
    "generate": "turbo run generate",
    "check": "turbo run check",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "fmt": "oxfmt && turbo run fmt",
    "fmt:check": "oxfmt --check && turbo run fmt:check"
  },
  "devDependencies": {
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "svelte": "^5.57.2",
    "turbo": "^2.11.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "error"
    }
  }
}
